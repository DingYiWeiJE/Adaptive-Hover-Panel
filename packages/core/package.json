{
  "name": "@adaptive-hover/core",
  "version": "0.0.0",
  "description": "Layout algorithm core for Adaptive Hover Panel — viewport-aware positioning logic, framework-agnostic.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.7",
    "tsup": "^8.5.1",
    "vitest": "^4.1.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
